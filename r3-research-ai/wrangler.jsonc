{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "r3-research-ai",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GEMINI_MODEL": "gemini-2.5-flash-lite"
  }
}
